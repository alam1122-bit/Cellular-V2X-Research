from env_test import Environment
import numpy as np
import matplotlib.pyplot as plt
env = Environment()
np.random.seed(15)
env.restart(gapV2V=40)
env.plot_grid()

# Fixed V2I

v2i_rb = [0,1,2,3]
v2i_power_db = [23, 23, 23, 23]
print(f'V2I Resource Block: {v2i_rb}')
print(f'V2I Power (dB):     {v2i_power_db}\n')
# Select V2V RB and Power level
v2v_rb = [1,1,1,1]
v2v_power_db = [10, 15, 23, 23]
env.step(v2i_rb, v2i_power_db, v2v_rb, v2v_power_db, agent=1)

print(f'V2V Resource Block: {v2v_rb}')
print(f'V2V Power (dB):     {v2v_power_db}')

plt.imshow(10*np.log10(env.v2i_interference), cmap = 'Reds')
plt.xlabel('channel')
plt.ylabel('bst')
plt.xticks([0, 1, 2, 3], ['0', '1', '2', '3'],rotation=0)
plt.yticks([0], ['0'],rotation=0)
plt.title('V2I Interference (dB)')

for i in range(1):
    for j in range(4):
        text = plt.text(j, i, round(10*np.log10(env.v2i_interference[i,j]),2),
                       ha="center", va="center", color="k")
plt.show()

plt.imshow(10*np.log10(env.v2v_interference),cmap = 'Reds')
plt.xlabel('channel')
plt.ylabel('V2V Receiver')
# plt.xticks()
plt.xticks([0, 1, 2,3], ['0', '1', '2', '3'],rotation=0)
plt.yticks([0, 1, 2,3], ['0', '1', '2', '3'],rotation=0)
plt.title('V2V Interference (dB)')

for i in range(4):
    for j in range(4):
        text = plt.text(j, i, round(10*np.log10(env.v2v_interference[i,j]),2),
                       ha="center", va="center", color="k")
        
plt.show()

print(f"V2I Capacity: {env.v2i_capacity} Mbps")
print(f"V2V Capacity: {env.v2v_capacity} Mbps")



